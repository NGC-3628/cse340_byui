<%- include('partials/header') %>

<main>
    <h1><%= organizationDetails.name %></h1>
    
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" style="max-width: 150px;">
    
    <p><%= organizationDetails.description %></p>
    <p><strong>Contact:</strong> <%= organizationDetails.contact_email %></p>

    <h2>Projects</h2>
    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }); %>
        <% } else { %>
            <li>No projects currently listed for this organization.</li>
        <% } %>
    </ul>
    <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
    <p><a href="/organizations">&larr; Back to all organizations</a></p>
</main>

<%- include('partials/footer') %>