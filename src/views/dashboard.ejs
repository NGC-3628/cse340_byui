<div class="dashboard-commitments">
        <h3 style="border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 20px;">My Volunteer Commitments</h3>
        
        <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
            <ul class="commitment-list">
                <% volunteeredProjects.forEach(project => { %>
                    <li class="commitment-card">
                        <a href="/project/<%= project.project_id %>" class="commitment-title">
                            <%= project.title %>
                        </a>
                        <div class="commitment-meta">
                            <span class="date">📅 <%= new Date(project.date).toLocaleDateString() %></span>
                            <span class="separator">|</span>
                            <span class="org">🏢 <%= project.organization_name %></span>
                        </div>
                        <div>
                            <a href="/project/<%= project.project_id %>/unvolunteer" class="btn-danger-text">Remove me as volunteer</a>
                        </div>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <div class="empty-state">
                <p>You haven't signed up for any projects yet.</p>
                <a href="/projects" class="btn-primary" style="margin-top: 10px;">Find a Project</a>
            </div>
        <% } %>
    </div>