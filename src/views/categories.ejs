<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <h2>Explore our service categories:</h2>
    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.id %>"><strong><%= category.name %></strong></a>
                    <% if (category.description) { %>
                        <p><%= category.description %></p>
                    <% } %>
                </li>
            <% }); %>
        <% } else { %>
            <li>No categories found.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>

<!-- 

In the EJS template, we use the syntax `<%= %>` 
to insert dynamic data into the HTML. 
For example, in the line 
`<a href="/category/<%= category.id %>"><strong><%= category.name %></strong></a>`, 
we are inserting the `category.id` into the `href` 
attribute of the `<a>` tag, and the `category.name` 
    is being inserted as the text content of the link.
    
    
    -->