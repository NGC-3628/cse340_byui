<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-category/<%= categoryDetails.id %>" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input 
                type="text" 
                id="name" 
                name="name" 
                value="<%= categoryDetails.name %>" 
                maxlength="100" 
                required 
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description"><%= categoryDetails.description %></textarea>
        </div>

        <button type="submit">Update Category</button>
    </form>
</main>
<%- include('partials/footer') %>