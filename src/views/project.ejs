<div class="volunteer-action-box">
        <% if (isLoggedIn) { %>
            <% if (isVolunteering) { %>
                <div class="volunteer-status-active">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    You are volunteering for this project.
                </div>
                <a href="/project/<%= projectDetails.project_id %>/unvolunteer" class="btn-danger-text">Cancel Volunteering</a>
            <% } else { %>
                <a href="/project/<%= projectDetails.project_id %>/volunteer" class="btn-primary">Volunteer for this Project</a>
            <% } %>
        <% } else { %>
            <p><em>Please <a href="/login" style="color: var(--accent); font-weight: bold;">log in</a> to volunteer for this project.</em></p>
        <% } %>
    </div>