<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are the next 5 upcoming service projects:</p>

    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                    - Hosted by: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </li>
            <% }); %>
        <% } else { %>
            <li>No upcoming projects found.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>